<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Dark Glass Fill (rgba(28,32,38,0.60) -> #991C2026) -->
    <solid android:color="@color/glass_panel" />

    <!-- Subtle white border for glass edge highlight -->
    <stroke
        android:width="1dp"
        android:color="@color/glass_border" />

    <!-- Rounded corners matching the Stitch design's rounded-[24px] -->
    <corners android:radius="@dimen/card_corner_radius" />

</shape>
