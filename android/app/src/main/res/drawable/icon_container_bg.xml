<?xml version="1.0" encoding="utf-8"?>
<!--
    icon_container_bg.xml — App Icon Rounded Square Background

    WHY THIS EXISTS:
    The Stitch design shows the app icon as a black rounded square (like an iOS/Android
    home screen icon). This drawable is the background for that container — a black
    rounded square with 28dp corner radius (matching Stitch's rounded-[32px] at 780dp width).

    Used as background for the CardView/FrameLayout that holds our logo vector.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Primary black — the icon container background -->
    <solid android:color="#1A1A1A" />

    <!-- 28dp corner radius gives the modern "squircle" app icon shape -->
    <corners android:radius="24dp" />

</shape>
