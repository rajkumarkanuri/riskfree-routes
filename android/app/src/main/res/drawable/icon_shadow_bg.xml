<?xml version="1.0" encoding="utf-8"?>
<!--
    icon_shadow_bg.xml
    Transparent background with a subtle drop shadow layer.
    Used behind the logo image to give it the floating "card" feel
    matching the Stitch design's icon-shadow class.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft shadow layer (simulated using a slightly offset shape) -->
    <item
        android:top="6dp"
        android:left="4dp"
        android:right="4dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#20000000"/>
            <corners android:radius="26dp"/>
        </shape>
    </item>
    <!-- White squircle card face -->
    <item android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
</layer-list>
