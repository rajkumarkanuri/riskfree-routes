<?xml version="1.0" encoding="utf-8"?>
<!--
    splash_window_bg.xml — Instant Window Background

    WHY THIS EXISTS:
    Before Android even inflates our layout XML, it shows the window background.
    Using a plain light color here prevents the white "cold launch" flash.
    The actual animated blobs and glass content are in activity_splash.xml.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- #f9f9fb matches the Stitch design's background color exactly -->
    <solid android:color="#f9f9fb" />
</shape>
