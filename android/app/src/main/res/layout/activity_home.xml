<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".ui.home.HomeActivity">

    <!-- ── MAP CONTAINER ────────────────────────────────────────── -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/interaction_overlay_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="48dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/searchPillCard"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            app:cardCornerRadius="27dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/colorSurface"
            app:strokeColor="@color/colorSurfaceBorder"
            app:strokeWidth="1dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <!-- Search Icon -->
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/primary_blue_light" />

                <!-- Search Text / Hint -->
                <TextView
                    android:id="@+id/tv_search_hint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Where to safely?"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <!-- Profile Avatar Circle -->
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/img_profile"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_person"
                    app:civ_border_color="@color/primary_blue"
                    app:civ_border_width="1.5dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- ── MAP FLOATING CONTROLS (RIGHT SIDE) ───────────────────── -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginTop="120dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Map Layer Toggle Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_layer_map_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="Map Type"
            app:backgroundTint="@color/colorSurface"
            app:elevation="4dp"
            app:fabCustomSize="46dp"
            app:maxImageSize="22dp"
            app:srcCompat="@drawable/ic_layers"
            app:tint="@color/text_primary" />

        <!-- Recenter Location Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_layer_recenter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Recenter Map"
            app:backgroundTint="@color/colorSurface"
            app:elevation="4dp"
            app:fabCustomSize="46dp"
            app:maxImageSize="22dp"
            app:srcCompat="@drawable/ic_my_location"
            app:tint="@color/primary_blue_light" />
    </LinearLayout>

    <!-- ── GUARDIAN ACTIVE STATUS PILL ───────────────────────────── -->
    <LinearLayout
        android:id="@+id/guardian_mode_pill"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="start|top"
        android:layout_marginTop="120dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_pill_glass"
        android:backgroundTint="@color/success_green_subtle"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_shield"
            app:tint="@color/success_green" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Guardian Active"
            android:textColor="@color/success_green"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ── SOS EMERGENCY FAB (BOTTOM RIGHT ABOVE BOTTOM SHEET) ───── -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btn_sos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="160dp"
        android:text="SOS"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="14sp"
        app:backgroundTint="@color/danger_red"
        app:elevation="8dp"
        app:icon="@drawable/ic_sos"
        app:iconTint="@color/white" />

    <!-- ── BOTTOM SHEET CONTAINER ───────────────────────────────── -->
    <LinearLayout
        android:id="@+id/bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/shape_bottom_sheet_bg"
        android:elevation="@dimen/panel_elevation"
        app:behavior_hideable="false"
        app:behavior_peekHeight="140dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <!-- Drag Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/shape_circle"
            android:backgroundTint="@color/colorSurfaceBorder" />

        <FrameLayout
            android:id="@+id/bottom_sheet_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="100dp">

            <!-- 1. SEARCH / AUTOCOMPLETE STATE -->
            <LinearLayout
                android:id="@+id/container_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:id="@+id/btn_search_back"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="8dp"
                        android:src="@drawable/ic_back"
                        app:tint="@color/text_primary" />

                    <EditText
                        android:id="@+id/et_search_expanded"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/input_height"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/glass_input_bg"
                        android:hint="Search destination..."
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="15sp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_suggestions"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:clipToPadding="false"
                    android:paddingBottom="16dp" />
            </LinearLayout>

            <!-- 2. ROUTE SELECTION STATE -->
            <LinearLayout
                android:id="@+id/container_route_selection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="20dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tv_destination_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="To: Selected Destination"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <ImageView
                        android:id="@+id/btn_route_close"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="8dp"
                        android:src="@drawable/ic_close"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <!-- Route Cards List -->
                <LinearLayout
                    android:id="@+id/container_route_cards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Safety Summary Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_safety_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/colorSurfaceVariant"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/colorSurfaceBorder"
                    app:strokeWidth="1dp"
                    app:contentPadding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_shield"
                                app:tint="@color/success_green" />

                            <TextView
                                android:id="@+id/tv_summary_score"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Safety Score: 94/100 (Safest)"
                                android:textColor="@color/success_green"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_summary_reports"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="• 0 Active Hazards"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tv_summary_emergency"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="• 4 Help Centers"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_start_navigation"
                    style="@style/Widget.RiskFreeRoutes.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:text="Start Safe Navigation"
                    app:icon="@drawable/ic_navigation"
                    app:iconGravity="textStart" />
            </LinearLayout>

            <!-- 3. LIVE NAVIGATION STATE -->
            <LinearLayout
                android:id="@+id/container_navigation_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="20dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Navigating safely..."
                            android:textColor="@color/primary_blue_light"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Guardian AI is actively monitoring hazards"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_exit_navigation"
                        style="@style/Widget.RiskFreeRoutes.Button.Danger"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:text="Exit" />
                </LinearLayout>
            </LinearLayout>

        </FrameLayout>
    </LinearLayout>

    <!-- ── BOTTOM NAVIGATION BAR ────────────────────────────────── -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_gravity="bottom"
        android:background="@color/colorSurface"
        app:elevation="8dp"
        app:itemIconTint="@color/text_secondary"
        app:itemTextColor="@color/text_secondary"
        app:itemActiveIndicatorStyle="@style/ShapeAppearance.RiskFreeRoutes.SmallComponent"
        app:menu="@menu/menu_home_bottom_nav" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
