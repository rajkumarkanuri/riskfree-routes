<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".ui.splash.SplashActivity">

    <!-- ══════════════════════════════════════════════════════
         LAYER 1: AMBIENT COLOUR BLOBS (Stitch design)
         blob-1 = #D8E3FF  (dusty blue,  top-left)
         blob-2 = #F5DAF4  (lavender,    bottom-right)
         blob-3 = #E8F5E9  (mint green,  middle-right)
    ═══════════════════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/blob_blue"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:alpha="0.55"
            android:background="@drawable/shape_circle"
            android:backgroundTint="#D8E3FF"
            android:translationX="-80dp"
            android:translationY="-80dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/blob_lavender"
            android:layout_width="360dp"
            android:layout_height="360dp"
            android:alpha="0.50"
            android:background="@drawable/shape_circle"
            android:backgroundTint="#F5DAF4"
            android:translationX="80dp"
            android:translationY="100dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/blob_mint"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:alpha="0.45"
            android:background="@drawable/shape_circle"
            android:backgroundTint="#C8F0E0"
            android:translationX="60dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.25" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ══════════════════════════════════════════════════════
         LAYER 2: FROSTED GLASS OVERLAY
         rgba(255,255,255,0.65) — blobs bleed through as washes
    ═══════════════════════════════════════════════════════════ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/glass_panel" />

    <!-- ══════════════════════════════════════════════════════
         LAYER 3: CONTENT
    ═══════════════════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ─────────────────────────────────────────────────
             GLASS CARD (centre)
             Semi-transparent white card with border — Stitch glass effect
        ──────────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/layout_splash_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:layout_marginEnd="36dp"
            android:background="@drawable/glass_card_bg"
            android:elevation="6dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingTop="48dp"
            android:paddingEnd="36dp"
            android:paddingBottom="48dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.44">

            <!-- ── APP LOGO ──────────────────────────────────
                 Your actual logo (R + road) displayed as a
                 white squircle with drop shadow.
                 Matches Stitch: w-32 h-32 rounded-[32px] icon-shadow
                 NO black container — logo has its own white bg.
            ─────────────────────────────────────────────── -->
            <ImageView
                android:id="@+id/img_logo"
                android:layout_width="120dp"
                android:layout_height="119dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/icon_shadow_bg"
                android:contentDescription="RiskFree Routes Logo"
                android:elevation="14dp"
                android:padding="0dp"
                android:scaleType="fitXY"
                android:src="@drawable/ic_app_logo" />

            <!-- spacing -->
            <Space android:layout_width="1dp" android:layout_height="28dp" />

            <!-- ── APP NAME ───────────────────────────────────
                 "RiskFree Routes"
                 Stitch: font-headline-lg-mobile, text-primary (@color/text_primary), tracking-tight
            ─────────────────────────────────────────────── -->
            <TextView
                android:id="@+id/tv_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:text="RiskFree Routes"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- spacing -->
            <Space android:layout_width="1dp" android:layout_height="8dp" />

            <!-- ── TAGLINE ────────────────────────────────────
                 "SOPHISTICATED TRAVEL"
                 Stitch: text-on-surface-variant/60, uppercase, tracking-[0.2em]
            ─────────────────────────────────────────────── -->
            <TextView
                android:id="@+id/tv_tagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:letterSpacing="0.18"
                android:text="SOPHISTICATED TRAVEL"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- ─────────────────────────────────────────────────
             PULSING DOTS (bottom, opacity 40%)
             Stitch: 3 × w-1.5 h-1.5 bg-primary animate-pulse
             staggered: 0ms / 200ms / 400ms
        ──────────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/layout_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="56dp"
            android:alpha="0.4"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <View
                android:id="@+id/dot_1"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/shape_circle"
                android:backgroundTint="@color/primary_blue" />

            <View
                android:id="@+id/dot_2"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/shape_circle"
                android:backgroundTint="@color/primary_blue" />

            <View
                android:id="@+id/dot_3"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/shape_circle"
                android:backgroundTint="@color/primary_blue" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
