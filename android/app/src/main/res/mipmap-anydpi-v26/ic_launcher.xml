<?xml version="1.0" encoding="utf-8"?>
<!--
    ic_launcher.xml — Adaptive Icon (API 26+)

    Android Adaptive Icons have two layers:
    - background: a solid colour or shape (shown behind the logo)
    - foreground: your actual logo image (cropped to a circle/squircle by the launcher)

    We use the PNG version of the logo as the foreground so your
    exact R+road design appears on the home screen icon.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pure white background — matches your logo's own white background -->
    <background android:drawable="@color/ic_launcher_background" />
    <!-- Your R+road logo as the foreground -->
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <!-- Monochrome version (used for themed icons on Android 13+) -->
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
