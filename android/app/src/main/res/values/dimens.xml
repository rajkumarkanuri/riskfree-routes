<?xml version="1.0" encoding="utf-8"?>
<!--
    dimens.xml — SPACING AND SIZE CONSTANTS

    WHY THIS EXISTS:
    Instead of writing android:padding="16dp" everywhere (and risking inconsistency),
    we define standard spacing values here. This enforces a consistent visual grid
    across all screens — a core principle of Material Design.

    SPACING SCALE (based on 8dp grid system):
    4dp  → xs (extra small — tight gaps inside components)
    8dp  → sm (small — inner padding of compact components)
    12dp → md_sm (medium-small — standard item spacing)
    16dp → md (medium — standard screen horizontal margin)
    24dp → lg (large — section spacing)
    32dp → xl (extra large — hero section padding)
    48dp → xxl (double extra large — large icon sizes)
-->
<resources>

    <!-- ── STANDARD SPACING ──────────────────────────────────── -->
    <dimen name="spacing_xs">4dp</dimen>
    <dimen name="spacing_sm">8dp</dimen>
    <dimen name="spacing_md_sm">12dp</dimen>
    <dimen name="spacing_md">16dp</dimen>
    <dimen name="spacing_lg">24dp</dimen>
    <dimen name="spacing_xl">32dp</dimen>
    <dimen name="spacing_xxl">48dp</dimen>

    <!-- ── SCREEN MARGINS ────────────────────────────────────── -->
    <!-- The left and right padding on every screen — ensures content
         doesn't touch the edge of the phone screen. -->
    <dimen name="screen_horizontal_margin">20dp</dimen>
    <dimen name="screen_vertical_margin">24dp</dimen>

    <!-- ── CARD STYLING ──────────────────────────────────────── -->
    <dimen name="card_corner_radius">16dp</dimen>
    <dimen name="card_elevation">2dp</dimen>
    <dimen name="card_padding">16dp</dimen>

    <!-- ── BUTTON SIZING ─────────────────────────────────────── -->
    <dimen name="button_height">52dp</dimen>
    <dimen name="button_corner_radius">12dp</dimen>
    <dimen name="button_text_size">16sp</dimen>

    <!-- ── TEXT FIELD SIZING ──────────────────────────────────── -->
    <dimen name="input_corner_radius">12dp</dimen>

    <!-- ── ICON SIZES ─────────────────────────────────────────── -->
    <dimen name="icon_sm">20dp</dimen>
    <dimen name="icon_md">24dp</dimen>
    <dimen name="icon_lg">36dp</dimen>
    <dimen name="icon_xl">48dp</dimen>
    <dimen name="icon_xxl">72dp</dimen>

    <!-- ── TYPOGRAPHY SIZES ──────────────────────────────────── -->
    <dimen name="text_xs">10sp</dimen>
    <dimen name="text_sm">12sp</dimen>
    <dimen name="text_md">14sp</dimen>
    <dimen name="text_body">16sp</dimen>
    <dimen name="text_subtitle">18sp</dimen>
    <dimen name="text_title">22sp</dimen>
    <dimen name="text_heading">28sp</dimen>
    <dimen name="text_display">34sp</dimen>

    <!-- ── SPECIFIC COMPONENT SIZES ─────────────────────────── -->
    <!-- Safety score badge circle size -->
    <dimen name="score_badge_size">72dp</dimen>

    <!-- Avatar / profile picture size -->
    <dimen name="avatar_size_sm">40dp</dimen>
    <dimen name="avatar_size_md">72dp</dimen>
    <dimen name="avatar_size_lg">100dp</dimen>

    <!-- SOS button diameter (large circle button) -->
    <dimen name="sos_button_size">140dp</dimen>

    <!-- Bottom navigation height -->
    <dimen name="bottom_nav_height">64dp</dimen>

    <!-- Toolbar / AppBar height -->
    <dimen name="toolbar_height">56dp</dimen>

    <!-- Map bottom sheet peek height (how far it pops up above the map) -->
    <dimen name="bottom_sheet_peek_height">260dp</dimen>

</resources>
