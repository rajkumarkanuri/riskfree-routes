<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.RiskFreeRoutes" parent="Theme.Material3.Dark.NoActionBar">

        <!-- ── COLOR ATTRIBUTES ─────────────────────────────── -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryContainer">@color/primary_blue_light</item>
        <item name="colorOnPrimary">@color/text_primary</item>

        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorOnSecondary">@color/text_primary</item>

        <item name="colorTertiary">@color/danger_red</item>
        <item name="colorError">@color/danger_red</item>

        <item name="colorSurface">@color/glass_panel</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <item name="android:colorBackground">@color/colorBackground</item>

        <!-- ── STATUS + NAVIGATION BAR ───────────────────────── -->
        <item name="android:statusBarColor">@color/colorBackground</item>
        <item name="android:navigationBarColor">@color/colorBackground</item>

        <!-- ── SHAPE ─────────────────────────────────────────── -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.RiskFreeRoutes.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.RiskFreeRoutes.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.RiskFreeRoutes.LargeComponent</item>

    </style>

    <style name="ShapeAppearance.RiskFreeRoutes.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="ShapeAppearance.RiskFreeRoutes.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="ShapeAppearance.RiskFreeRoutes.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerRadius">24dp</item>
    </style>

    <style name="Theme.RiskFreeRoutes.Splash" parent="Theme.RiskFreeRoutes">
        <item name="android:windowBackground">@drawable/splash_window_bg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- ────────────────────────────────────────────────────────
         REUSABLE WIDGET STYLES (DARK GLASS SPEC)
    ───────────────────────────────────────────────────────────-->

    <style name="Widget.RiskFreeRoutes.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary_blue</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">@dimen/button_text_size</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.RiskFreeRoutes.Button.SafeGreen" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/success_green</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">@dimen/button_text_size</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.RiskFreeRoutes.Button.Danger" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/danger_red</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="cornerRadius">50dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.RiskFreeRoutes.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">#33FFFFFF</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="Widget.RiskFreeRoutes.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/glass_panel</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/glass_border</item>
        <item name="contentPadding">@dimen/card_padding</item>
    </style>

    <!-- Typography Styles -->
    <style name="TextAppearance.RiskFreeRoutes.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.RiskFreeRoutes.Subtitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.RiskFreeRoutes.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.RiskFreeRoutes.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <!-- ── PROFILE SCREEN ACTION ROW ─────────────────────────────────
         Reusable style for each tappable row in the Profile action list.
         56dp height guarantees WCAG-compliant touch target size.
         Consumers set android:id and android:background via layout.
    ──────────────────────────────────────────────────────────────── -->
    <style name="ProfileActionRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- ── PROFILE DIVIDER ───────────────────────────────────────────
         Thin separator between action rows (inset left to align with text).
    ──────────────────────────────────────────────────────────────── -->
    <style name="ProfileDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">60dp</item>
        <item name="android:background">#1AFFFFFF</item>
    </style>

</resources>
